NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CRM_URL=http://localhost:3001/login
NEXT_PUBLIC_ALLOW_MOCK_PAYMENT=true
NEXT_PUBLIC_SUPPORT_EMAIL=hello@amaravisa.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-80-0000-0000
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/918000000000
# Single-office Google Maps — AmaraVisa, Radhe Times Square, Kudasan, Gandhinagar
NEXT_PUBLIC_OFFICE_MAPS_URL=https://www.google.com/maps/dir/?api=1&destination=AmaraVisa+India+Private+Limited,+RADHE+Times+Square,+408,+Kudasan,+Gandhinagar,+Gujarat+382421
# Canonical public site URL (no trailing slash) — required for production SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 measurement ID (defaults to G-TJBJQ9HER2 if unset; set empty to disable)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TJBJQ9HER2
# Optional app store links (defaults to /coming-soon until real store URLs are set)
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.amaravisa.app
# Firebase Auth (Google sign-in) — required for "Continue with Google"
# Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=amaravisa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=amaravisa
NEXT_PUBLIC_FIREBASE_APP_ID=
